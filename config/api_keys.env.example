# API Keys Configuration
# Copy this file to api_keys.env and fill in your actual API keys
# IMPORTANT: Never commit api_keys.env to git (it's in .gitignore)

# OpenAI API Key (for DALL-E 3 image generation)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API Key (for educational diagrams and technical illustrations)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-gemini-key-here

# Google Cloud Vision API Key (for image analysis and processing)
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your-vision-api-key-here

# Google Cloud Project ID (required for Cloud Vision services)
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here

# Optional: Set to 'true' to enable dry-run mode (estimate costs without generating)
DRY_RUN=false

# Optional: Maximum budget in USD (prevents accidental overspending)
MAX_BUDGET=100.00
